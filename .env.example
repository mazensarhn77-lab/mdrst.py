# Supabase Dashboard → Connect → Transaction pooler connection string.
# Keep the real value in Vercel Environment Variables, never commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER_HOST:6543/postgres
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-secret
COOKIE_SECURE=1
